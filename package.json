{
  "name": "@particle-academy/fancy-template-ui",
  "version": "0.1.0",
  "description": "A visual builder for paged document templates: a block list, the selected block's settings and a paged preview that is page for page what fine-print writes. Edits one fancy-template envelope, controlled and JSON; fields from a host list as chips, host block kinds, repeating sections, and agent edits staged for a person to accept.",
  "keywords": [
    "document-builder",
    "template",
    "pdf",
    "fine-print",
    "fancy-template",
    "react",
    "human-plus",
    "agent",
    "particle-academy"
  ],
  "homepage": "https://github.com/Particle-Academy/fancy-template-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/fancy-template-ui.git"
  },
  "bugs": "https://github.com/Particle-Academy/fancy-template-ui/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint .",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsup"
  },
  "peerDependencies": {
    "@particle-academy/fancy-doc-commons": ">=0.4.0 <2.0",
    "@particle-academy/fancy-template": ">=0.5.0 <2.0",
    "@particle-academy/last-word-ui": ">=0.6.0 <2.0",
    "@particle-academy/react-fancy": ">=6.29.0 <8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@particle-academy/last-word-ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@particle-academy/fancy-doc-commons": "^0.4.0",
    "@particle-academy/fancy-template": "^0.5.0",
    "@particle-academy/react-fancy": "^6.29.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "source-map-js": "^1.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
